<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsUraPlugin>true</IsUraPlugin>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2026.11.6.1</Version>
		<!-- 自动把本插件的 NuGet 运行时依赖闭包拷到输出。 -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- URA 插件元数据 -->
		<PluginInternalName>EventLoggerPlugin</PluginInternalName>
		<PluginDisplayName>记录事件信息&amp;干劲等</PluginDisplayName>
		<PluginAuthor>xulai1001</PluginAuthor>
		<PluginDescription>记录掉干劲的次数，事件加的属性，走完率等</PluginDescription>
		<PluginChangelog>适配 Festa 训练、事件、比赛与学技能统计，嵌入附加区域并排除友人连续事件；按 RequestId 关联训练结果；Festa 按原始指令区分普通训练与演目稽古并累计次数；继承属性按单次数值三档着色。</PluginChangelog>
		<PluginRepositoryUrl>https://github.com/URA-Plugins/EventLoggerPlugin</PluginRepositoryUrl>
		<PluginDependencies>LegendScenarioAnalyzer,RamenScenarioAnalyzer,PioneerScenarioAnalyzer,FestaScenarioAnalyzer</PluginDependencies>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="deps/EventResponseAnalyzer/**/*.cs" />
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="deps\FestaScenarioAnalyzer\FestaScenarioAnalyzer.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="deps\LegendScenarioAnalyzer\LegendScenarioAnalyzer.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="deps\RamenScenarioAnalyzer\RamenScenarioAnalyzer.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="deps\PioneerScenarioAnalyzer\PioneerScenarioAnalyzer\PioneerScenarioAnalyzer.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="UmamusumeResponseAnalyzer" Version="[2026.11.1.2,)" PrivateAssets="all" />
	</ItemGroup>

</Project>
